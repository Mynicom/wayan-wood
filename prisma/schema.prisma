generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// NextAuth Tables
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("admin")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts Account[]
  sessions Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// Business Tables
// ============================================

model Category {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  image       String
  description String   @default("")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

model Product {
  id                   Int      @id @default(autoincrement())
  categoryId           Int      @map("category_id")
  name                 String
  slug                 String   @unique
  price                Decimal  @db.Decimal(12, 2)
  thumbnail            String
  shortDescription     String   @map("short_description") @default("")
  productDescription   String   @map("product_description") @default("") @db.Text
  productSpecification String   @map("product_specification") @default("") @db.Text
  material             String   @default("")
  finishing            String   @default("")
  stock                Int      @default(0)
  views                Int      @default(0)
  orderCount           Int      @default(0) @map("order_count")
  minimumOrder         String   @default("10 pcs") @map("minimum_order")
  leadTime             String   @default("5-10 hari kerja") @map("lead_time")
  isBestSeller         Boolean  @default(false) @map("is_best_seller")
  isFeatured           Boolean  @default(false) @map("is_featured")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  category   Category          @relation(fields: [categoryId], references: [id])
  images     ProductImage[]
  dimensions ProductDimension?
  orderItems OrderItem[]

  @@index([categoryId, isActive])
  @@index([isActive, createdAt])
  @@index([isActive, isBestSeller])
  @@index([isActive, views])
  @@map("products")
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  image     String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model ProductDimension {
  id        Int      @id @default(autoincrement())
  productId Int      @unique @map("product_id")
  width     String   @default("")
  height    String   @default("")
  length    String   @default("")
  weight    String   @default("")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_dimensions")
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String   @default("")
  subject   String   @default("")
  message   String   @db.Text
  status    String   @default("unread")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("contact_messages")
}

model WebsiteSettings {
  id          Int      @id @default(autoincrement())
  websiteName String   @default("Wayan Wood Work") @map("website_name")
  logo        String   @default("")
  favicon     String   @default("")
  email       String   @default("")
  phone       String   @default("")
  whatsapp    String   @default("")
  address     String   @default("")
  instagram   String   @default("")
  facebook    String   @default("")
  tiktok      String   @default("")
  youtube     String   @default("")
  googleMaps  String   @default("") @map("google_maps")
  copyright   String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("website_settings")
}

model Page {
  id        Int      @id @default(autoincrement())
  title     String
  slug      String   @unique
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("pages")
}

// ============================================
// Dashboard Tables
// ============================================

model Visitor {
  id        Int      @id @default(autoincrement())
  date      DateTime @db.Date
  count     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([date])
  @@map("visitors")
}

model Order {
  id           Int      @id @default(autoincrement())
  orderNumber  String   @unique @map("order_number")
  customerName String   @map("customer_name")
  email        String
  phone        String   @default("")
  address      String   @default("")
  totalAmount  Decimal  @db.Decimal(12, 2) @map("total_amount")
  status       String   @default("pending")
  notes        String   @default("") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  items OrderItem[]

  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int     @map("order_id")
  productId Int     @map("product_id")
  quantity  Int
  price     Decimal @db.Decimal(12, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  type      String
  message   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("activity_logs")
}
